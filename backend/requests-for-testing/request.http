POST http://localhost:8080/api/items
Content-Type: application/json

{
  "title": "The Hobbit",
  "creators": "J.R.R. Tolkien",
  "type": "BOOK",
  "status": "IN_PROGRESS",
  "progress": 50,
  "totalUnits": 300
}


GET http://localhost:8080/api/items


# Creating an item with no title
POST http://localhost:8080/api/items
Content-Type: application/json

{
  "type": "BOOK",
  "status": "PLANNED"
}

# Trying to fetch a non existing item, should return 404 with an error code.
GET http://localhost:8080/api/items/999

# Create an item with ID, then recreate it and then make sure that it doesn't pass.
POST http://localhost:8080/api/items
Content-Type: application/json

{
  "title": "The Hobbit",
  "type": "BOOK",
  "status": "PLANNED",
  "externalSource": "GOOGLE_BOOKS",
  "externalId": "abc123"
}

 # Search for a specific book
GET http://localhost:8080/api/search?q=the+hobbit

# Search and filter based on the book test.
GET http://localhost:8080/api/search?q=harry+potter&type=BOOK